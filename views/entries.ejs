<!DOCTYPE html>
<html  lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css"/>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="/app.js" defer></script>
</head>

<body>
  <h1><%= title %></h1>

  <form id="entry-form" class="flex flex-col gap-2 mb-6 sm:flex-row">
    <input
    class="form-input"
    type="text"
    name="title"
    placeholder="Title"
    required
  />

  <textarea
  class="form-input"
  name="body"
  placeholder="Body"
  required
  ></textarea>

  <button
  class="bg-teal-700 text-white rounded px-4 py-2 hover:bg-teal-800"
  type="submit">
    Add Entry
  </button>
  </form>

  <ul id="entries">
    <% entries.forEach((entry) => { %>
<li
data-id="<%= entry._id %>"
data-title="<%= entry.title %>"
data-body="<%= entry.body %>"
data-favorite="<%= entry.favorite %>"
>
<span class="entry-display">
  <strong><%= entry.title %>:</strong>
  <%= entry.body %>
</span>

<button class="favorite-btn" type="button">
  <%= entry.favorite ? "★" : "☆" %>
</button>

<button class="edit-btn" type="button">Edit</button>
<button
class="delete-btn"
type="button"
hx-delete="/entries/<%= entry._id %>"
hx-target="closest li"
hx-swap="outerHTML"
hx-confirm="Delete this entry?"
hx-indicator="#delete-indicator-<%= entry._id %>"
>Delete</button>

<span
  id="delete-indicator-<%= entry._id %>"
  class="delete-indicator htmx-indicator"
  >
Deleting...
</span>
</li>
<% }) %>
</ul>
</body>
</html>
